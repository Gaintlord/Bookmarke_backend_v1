# Server
PORT = 8081

# Public backend origin used to build absolute links inside emails.
# The verification link is: {API_BASE_URL}/api/v1/verify-email?userEmail=..&otp=..
# In production this MUST be the public origin reachable by email clients, e.g.
#   API_BASE_URL = https://bokmarke.world
# (a localhost value here makes email links point at the recipient's machine).
API_BASE_URL = http://localhost:8081

# SMTP server used to send verification emails.
# SMTP_SECURE must be "true" for implicit TLS (usually port 465) and "false"
# for STARTTLS (usually port 587).
SMTP_HOST =
SMTP_PORT = 587
SMTP_SECURE = false
SMTP_USER =
SMTP_PASS =
SMTP_FROM = noreply@bokmarke.world

# Database
DATABASE_URL = postgresql://<user>:<password>@<host>:<port>/<database>

# Password hashing
BCRYPTSALT=9
CRYPTOSECRET=replace-with-a-long-random-secret

# JWT secrets
JWT_SECRET_A = replace-with-access-token-secret
JWT_SECRET_R = replace-with-refresh-token-secret

# Token lifetimes (milliseconds)
# 24 hours  = 86400000
# 14 days   = 1209600000
ACCESS_TOKEN_EXP = 86400000
REFRESH_TOKEN_EXP = 1209600000

# Google OAuth
GOOGLE_REDIRECT = http://localhost:8081/api/v1/googleredirect
GOOGLE_C_ID = replace-with-google-client-id
GOOGLE_C_SECRET = replace-with-google-client-secret

# Client
# Frontend origin. Used as the base for post-verification redirects:
#   {CLIENT_ORIGIN}/verify-status?status=verified|expired|unverified
#   {CLIENT_ORIGIN}/dashboard
CLIENT_ORIGIN = http://localhost:5173

# Cookie domain for the auth cookies. Leave UNSET when the frontend and API
# share one origin (the cookie is then host-only). Set it only when the API is
# on a subdomain and the cookie must be shared with the frontend, e.g.
#   COOKIE_DOMAIN = bokmarke.world
# COOKIE_DOMAIN =

# Set to "production" on the server so auth cookies get the Secure attribute.
NODE_ENV = development
